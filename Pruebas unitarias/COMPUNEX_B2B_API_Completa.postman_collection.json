              "mode": "raw",
              "raw": "{\n  \"categoriaId\": \"ram\",\n  \"titulo\": \"Memoria RAM Kingston Fury Beast 16GB DDR4 3200MHz\",\n  \"descripcion\": \"Pack mayorista de memorias RAM DDR4 de alto rendimiento.\",\n  \"modeloComercial\": \"DISTRIBUIDOR_OFICIAL\",\n  \"tipoFormato\": \"Caja x 10 unidades\",\n  \"unidadesPorPaquete\": \"10\",\n  \"pedidoMinimo\": \"1 paquete\",\n  \"precioUnitarioRef\": 34.50,\n  \"precioTotalRef\": 345.00,\n  \"moneda\": \"USD\",\n  \"terminosComerciales\": \"Garantía 24 meses.\",\n  \"especificaciones\": [\n    { \"clave\": \"Capacidad\", \"valor\": \"16GB\" },\n    { \"clave\": \"Frecuencia\", \"valor\": \"3200MHz\" }\n  ],\n  \"imagenes\": [\n    { \"urlImagen\": \"https://img.compunex.com/products/ram-kingston-16gb-front.jpg\", \"orden\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/providers/me/products",
              "host": ["{{baseUrl}}"],
              "path": ["providers", "me", "products"]
            },
            "description": "modeloComercial válidos: MAYORISTA_PURO | DISTRIBUIDOR_OFICIAL | IMPORTADOR_DIRECTO | FABRICANTE. En imagenes usar 'urlImagen'."
          }
        },
