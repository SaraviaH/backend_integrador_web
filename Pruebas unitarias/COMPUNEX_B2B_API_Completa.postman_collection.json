          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.nombreArchivo) { pm.collectionVariables.set('uploadedFilename', json.nombreArchivo); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/media/upload?folder=products",
              "host": ["{{baseUrl}}"],
              "path": ["media", "upload"],
              "query": [
                { "key": "folder", "value": "products" }
              ]
            },
            "description": "Seleccionar un archivo JPEG, PNG o WEBP (máx. 5MB) en form-data antes de enviar."
          }
        },
        {
          "name": "Obtener Archivo Subido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/media/files/products/{{uploadedFilename}}",
              "host": ["{{baseUrl}}"],
              "path": ["media", "files", "products", "{{uploadedFilename}}"]
            }
          }
        }
      ]
    }
  ]
}
