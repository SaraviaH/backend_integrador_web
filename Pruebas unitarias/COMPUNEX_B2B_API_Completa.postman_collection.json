            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoriaId\": \"ram\",\n  \"titulo\": \"Memoria RAM Kingston Fury Beast 16GB DDR4 3200MHz (Actualizado)\",\n  \"descripcion\": \"Pack mayorista actualizado.\",\n  \"modeloComercial\": \"DISTRIBUIDOR_OFICIAL\",\n  \"tipoFormato\": \"Caja x 10 unidades\",\n  \"unidadesPorPaquete\": \"10\",\n  \"pedidoMinimo\": \"1 paquete\",\n  \"precioUnitarioRef\": 33.00,\n  \"precioTotalRef\": 330.00,\n  \"moneda\": \"USD\",\n  \"terminosComerciales\": \"Garantía 24 meses.\",\n  \"especificaciones\": [\n    { \"clave\": \"Capacidad\", \"valor\": \"16GB\" }\n  ],\n  \"imagenes\": [\n    { \"urlImagen\": \"https://img.compunex.com/products/ram-kingston-16gb-front.jpg\", \"orden\": 1 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/providers/me/products/{{createdProductId}}",
              "host": ["{{baseUrl}}"],
              "path": ["providers", "me", "products", "{{createdProductId}}"]
            },
            "description": "Ejecutar primero 'Crear Producto' para poblar {{createdProductId}} (o reemplazar manualmente por {{productId}})."
          }
        },
