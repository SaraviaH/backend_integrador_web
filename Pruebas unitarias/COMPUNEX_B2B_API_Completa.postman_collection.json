    {
      "name": "07. Órdenes y Checkout",
      "item": [
        {
          "name": "Procesar Checkout Multi-Proveedor (guarda {{ordenId}} y {{subordenId}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.ordenId) { pm.collectionVariables.set('ordenId', String(json.ordenId)); }",
                  "if (json.facturasEmitidas && json.facturasEmitidas.length > 0 && json.facturasEmitidas[0].subordenId) {",
                  "  pm.collectionVariables.set('subordenId', String(json.facturasEmitidas[0].subordenId));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{buyerToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"datosFacturacion\": {\n    \"tipoComprobante\": \"FACTURA\",\n    \"rucReceptor\": \"20607776661\",\n    \"razonSocialReceptor\": \"Comercial Tech MYPE SAC\",\n    \"direccionFiscal\": \"Jr. Lampa 450\",\n    \"metodoPagoSimulado\": \"TRANSFERENCIA_B2B\"\n  },\n  \"items\": [\n    { \"productoId\": 1, \"cantidad\": 2 }\n  ]\n}"
            },
            "url": {
