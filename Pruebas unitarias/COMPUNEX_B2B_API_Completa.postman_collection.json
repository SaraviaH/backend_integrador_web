  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "buyerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "categoriaId", "value": "ram" },
